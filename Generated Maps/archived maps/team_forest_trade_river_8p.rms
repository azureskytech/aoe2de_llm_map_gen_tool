/*
  Team Forest Trade River - generated RMS
  8 players, intended for 4v4 with slots 1-4 west and 5-8 east.
  Base terrain is forest; explicit grass lands carve starts and paths.
  Known limitation: RMS cannot guarantee arbitrary lobby team assignment.
*/

<PLAYER_SETUP>
direct_placement
behavior_version 1
override_map_size 240

<LAND_GENERATION>
base_terrain FOREST
enable_waves 1

/* Central river. Water is left open north and south of the ford. */
