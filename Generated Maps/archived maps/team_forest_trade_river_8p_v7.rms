/*
  Team Forest Trade River - generated RMS
  8 players, intended for 4v4 with slots 1-4 west and 5-8 east.
  Ludicrous map size, forest base terrain, wider center river, compact central ford.
  Known limitation: RMS cannot guarantee arbitrary lobby team assignment.
*/

<PLAYER_SETUP>
direct_placement
behavior_version 1
override_map_size 480

<LAND_GENERATION>
base_terrain FOREST
enable_waves 1

/* Center river. Continuous overlapping water stamps prevent forest seams. */
create_land
{
  terrain_type WATER
  land_position 50 1
  base_size 10
  number_of_tiles 900
  border_fuzziness 1
  zone 70
}

