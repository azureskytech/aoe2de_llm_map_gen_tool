<TERRAIN_GENERATION>
/* No random forest fill is needed: FOREST is the base terrain. */
/* Grass lands above are deliberate clearings, paths, and resource pockets. */

<OBJECTS_GENERATION>
/* Standard starting town. */
create_object TOWN_CENTER
{
  set_place_for_every_player
  terrain_to_place_on GRASS
  min_distance_to_players 0
  max_distance_to_players 0
}

create_object VILLAGER
{
  set_place_for_every_player
  terrain_to_place_on GRASS
  min_distance_to_players 6
  max_distance_to_players 7
}

create_object SCOUT
{
  number_of_objects 1
  set_place_for_every_player
  terrain_to_place_on GRASS
  min_distance_to_players 7
  max_distance_to_players 9
}

/* Per-player start resources, all inside the open start circle. */
/* FORAGE assumes 125 food by default; resource_delta -5 makes 5 bushes total 600 food. */
create_object SHEEP
{
  number_of_objects 5
  set_place_for_every_player
  set_gaia_object_only
  set_loose_grouping
  group_placement_radius 4
  terrain_to_place_on GRASS
  min_distance_to_players 6
  max_distance_to_players 9
}

create_object FORAGE
{
  number_of_objects 5
  resource_delta -5
  set_place_for_every_player
  set_gaia_object_only
  set_tight_grouping
  group_placement_radius 2
  terrain_to_place_on GRASS
  min_distance_to_players 10
  max_distance_to_players 13
}

