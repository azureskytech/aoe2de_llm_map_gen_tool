<TERRAIN_GENERATION>
/* Fill remaining grass with forest while keeping starts and rivers open. */
create_terrain FOREST
{
  base_terrain GRASS
  land_percent 100
  number_of_clumps 999
  set_avoid_player_start_areas 16
  spacing_to_specific_terrain WATER 2
}

<OBJECTS_GENERATION>
/* Standard starting town. */
create_object TOWN_CENTER
{
  set_place_for_every_player
  min_distance_to_players 0
  max_distance_to_players 0
}

create_object VILLAGER
{
  set_place_for_every_player
  min_distance_to_players 6
  max_distance_to_players 7
}

create_object SCOUT
{
  set_place_for_every_player
  min_distance_to_players 7
  max_distance_to_players 9
}

/* Per-player resources placed on clear grass near starts. */
create_object SHEEP
{
  number_of_objects 4
  set_place_for_every_player
  set_gaia_object_only
  set_loose_grouping
  terrain_to_place_on GRASS
  min_distance_to_players 7
  max_distance_to_players 10
}

create_object FORAGE
{
  number_of_objects 6
  set_place_for_every_player
  set_gaia_object_only
  set_tight_grouping
  terrain_to_place_on GRASS
  min_distance_to_players 10
  max_distance_to_players 14
}

create_object GOLD
{
  number_of_objects 7
  set_place_for_every_player
  set_gaia_object_only
  set_tight_grouping
  terrain_to_place_on GRASS
  min_distance_to_players 15
  max_distance_to_players 20
}

create_object STONE
{
  number_of_objects 4
  set_place_for_every_player
  set_gaia_object_only
  set_tight_grouping
  terrain_to_place_on GRASS
  min_distance_to_players 18
  max_distance_to_players 24
}

create_object BOAR
{
  number_of_objects 2
  set_place_for_every_player
  set_gaia_object_only
  set_loose_grouping
  terrain_to_place_on GRASS
  min_distance_to_players 16
  max_distance_to_players 23
}

/* Extra neutral gold and stone in the four quadrants, away from the river. */
create_object GOLD
{
  number_of_objects 5
  number_of_groups 8
  set_gaia_object_only
  set_tight_grouping
  terrain_to_place_on GRASS
  min_distance_to_players 25
  min_distance_to_map_edge 8
}

