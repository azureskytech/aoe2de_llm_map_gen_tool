/*
  Cross Forest Circle - generated RMS
  8 players, circular fixed starts, forest terrain, cross-shaped rivers.
*/

<PLAYER_SETUP>
direct_placement
behavior_version 1
override_map_size 240

<LAND_GENERATION>
base_terrain GRASS
enable_waves 1

