/* Player lands: two starts per quadrant, arranged in a ring around the center. */
create_land
{
  terrain_type GRASS
  land_position 38 20
  base_size 13
  number_of_tiles 900
  border_fuzziness 2
  assign_to_player 1
  zone 1
  other_zone_avoidance_distance 4
}

