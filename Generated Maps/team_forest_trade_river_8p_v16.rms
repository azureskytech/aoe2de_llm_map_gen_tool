/*
  Team Forest Trade River Clean - generated RMS
  8 players, intended for team games with slots 1-4 west and 5-8 east.
  Config preset: v16.
  Base terrain is FOREST; explicit non-overlapping lands carve river, ford, paths, starts, and pockets.
  Python validation passed: no explicit terrain conflicts; river uses bounded terrain; path stamp coverage validated.
*/

<PLAYER_SETUP>
behavior_version 1
override_map_size 480
team_positions

<LAND_GENERATION>
base_terrain FOREST
enable_waves 0

/* Main terrain features. The internal validator rejects mixed-terrain overlaps. */
create_land
{
  terrain_type WATER
  land_position 50 23
  land_percent 100
  left_border 44
  right_border 44
  top_border 1
  bottom_border 55
  border_fuzziness 100
  zone 70
}

create_land
{
  terrain_type WATER
  land_position 50 77
  land_percent 100
  left_border 44
  right_border 44
  top_border 55
  bottom_border 1
  border_fuzziness 100
  zone 70
}

